# =============================================================================
# Advanced Wazuh SOC/XDR Platform — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in all values before running the platform.
# The .env file is gitignored and must NEVER be committed to version control.
#
# Usage:
#   cp .env.example .env
#   # Then edit .env and fill in all CHANGE_ME placeholders
# =============================================================================

# ── Wazuh API ─────────────────────────────────────────────────────────────────
# URL of the Wazuh Manager REST API.
WAZUH_API_URL=https://127.0.0.1:55000
# Wazuh API credentials (e.g. wazuh-wui user).
WAZUH_API_USER=CHANGE_ME
WAZUH_API_PASSWORD=CHANGE_ME
# TLS verification enabled by default. Set WAZUH_CA_CERT if using self-signed CA.
WAZUH_VERIFY_SSL=true
WAZUH_CA_CERT=configs/certs/wazuh_api.pem
# Client timeout in seconds and max retries for transient connection errors.
WAZUH_API_TIMEOUT=10.0
WAZUH_API_MAX_RETRIES=3

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
SOC_DB_USER=soc
SOC_DB_PASSWORD=CHANGE_ME
SOC_DB_NAME=advanced_wazuh_soc
SOC_DB_URL=postgresql+asyncpg://soc:CHANGE_ME@127.0.0.1:5432/advanced_wazuh_soc

# ── Redis ─────────────────────────────────────────────────────────────────────
SOC_REDIS_PASSWORD=CHANGE_ME
SOC_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0

# ── OpenSearch / Wazuh Indexer ───────────────────────────────────────────────
# Required for Phase 1 alert retrieval and Phase 2 event ingestion.
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME
# TLS verification enabled by default. Set OPENSEARCH_CA_CERT if using self-signed CA.
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_CA_CERT=configs/certs/opensearch.pem
OPENSEARCH_TIMEOUT=15.0
OPENSEARCH_MAX_RETRIES=3

# ── Application ───────────────────────────────────────────────────────────────
APP_DEBUG=false
